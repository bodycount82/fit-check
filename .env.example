# Copy to .env and fill in. NEVER commit .env.
#
# YouCam / Perfect Corp API key. Get one at:
#   https://yce.perfectcorp.com/api-console/en/api-keys/
# Sent as: Authorization: Bearer <key>
YOUCAM_API_KEY=

# Base host for the server-to-server API.
# NOTE: this is the API host, not yce.perfectcorp.com (that is the marketing /
# online-editor site and returns a 403 HTML page for API calls).
YOUCAM_API_BASE=https://yce-api-01.perfectcorp.com

# --- Optional: private advisor drop-in -------------------------------------
# The repo runs standalone with the built-in rule-based advisor.
# Point this at a local module (NOT committed) to swap in a different brain.
# Example: FITCHECK_ADVISOR=advisor_private:PrivateAdvisor
FITCHECK_ADVISOR=

# --- Optional: LLM-backed advisor (only used if FITCHECK_ADVISOR selects it) -
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
